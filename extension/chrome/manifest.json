{
  "manifest_version": 3,
  "name": "keybro",
  "version": "0.1.0",
  "description": "Tells the keybro Mac app who you're chatting with on web apps. Talks only to keybro on this Mac.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://mail.google.com/*",
        "https://app.slack.com/*",
        "https://www.linkedin.com/*",
        "https://x.com/*",
        "https://web.telegram.org/*",
        "https://discord.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
